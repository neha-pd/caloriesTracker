<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="expo.modules.fitlenswidgets" >

    <uses-sdk android:minSdkVersion="28" />

    <application>
        <receiver
            android:name="expo.modules.fitlenswidgets.TodayWidget"
            android:exported="false"
            android:label="FitLens Today" >
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/fitlens_today" />
        </receiver>
        <receiver
            android:name="expo.modules.fitlenswidgets.WaterWidget"
            android:exported="false"
            android:label="FitLens Water" >
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/fitlens_water" />
        </receiver>
        <receiver
            android:name="expo.modules.fitlenswidgets.CoachWidget"
            android:exported="false"
            android:label="FitLens Coach" >
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/fitlens_coach" />
        </receiver>
    </application>

</manifest>