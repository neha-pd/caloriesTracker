PORT=3000
# Leave DATABASE_URL empty for the local embedded database.
DATABASE_URL=
# Required in production. Local development generates a secret in .data/.
JWT_SECRET=
# Comma-separated browser origins. Restrict this before deployment.
CORS_ORIGIN=http://localhost:8081,http://localhost:8084
# Optional real recovery email delivery:
RESEND_API_KEY=
EMAIL_FROM=
# Optional Google token-verification audiences:
GOOGLE_CLIENT_IDS=

# Firebase Authentication on Spark (replaces local password auth when configured)
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
# Local development: absolute path to the service account; never commit it.
GOOGLE_APPLICATION_CREDENTIALS=
# Render: set FIREBASE_SERVICE_ACCOUNT_JSON as a secret environment variable.

# Optional free-only online coach; server-side only. Never use EXPO_PUBLIC for this key.
OPENROUTER_API_KEY=
