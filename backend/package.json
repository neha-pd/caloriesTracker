{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && mkdir -p dist/core && cp src/core/schema.sql dist/core/schema.sql",
    "start": "node dist/index.js",
    "migrate": "tsx src/core/migrate.ts",
    "test": "tsx --test test/*.test.ts",
    "dev:local": "DOTENV_CONFIG_PATH=/dev/null LOCAL_DATABASE_PATH=.data/local tsx watch src/index.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^10.3.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.5",
    "firebase-admin": "^14.4.0",
    "google-auth-library": "^10.6.2",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.6",
    "pino-pretty": "^11.2.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
