# ─────────────────────────────────────────────
# FitLens Backend — Environment Variables
# Copy to .env and fill in your values
# ─────────────────────────────────────────────

# ── Server ───────────────────────────────────
PORT=3000
NODE_ENV=development

# Generate with: openssl rand -hex 32
JWT_SECRET=4f0be87cf82940702bff7bf9d1467264ea2d64cad3a4f85d51320ab9d3f03771
# ── Database (PostgreSQL) ─────────────────────
# Local (Docker):
DATABASE_URL=postgresql://fitlens:fitlens_secret@localhost:5432/fitlens_db

# Production examples:
#   Railway:  postgresql://postgres:PASSWORD@HOST:PORT/railway
#   Neon:     postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require
#   Render:   postgresql://user:pass@HOST/fitlens

# ── Redis ─────────────────────────────────────
# Local (Docker):
REDIS_URL=redis://localhost:6379

# Production (Upstash free tier):
#   REDIS_URL=redis://default:PASSWORD@HOST.upstash.io:PORT

# ── Image Storage ─────────────────────────────
# Strategy: local disk in dev, Cloudinary in production
# Set STORAGE_MODE=local for dev, STORAGE_MODE=cloudinary for prod

STORAGE_MODE=local
UPLOAD_DIR=./uploads   # local dev only — served at /uploads/*

# Cloudinary (free tier: 25 GB storage, 25 GB bandwidth/month)
# Sign up at: https://cloudinary.com/users/register/free
# Dashboard → Settings → Access Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Google Gemini (Vision AI) ─────────────────
# Free at: https://aistudio.google.com → "Get API Key"
# Free tier: 15 requests/min on Gemini 1.5 Flash (plenty for dev)
GEMINI_API_KEY=AIzaSyAxhaHLTwgTyHnsedqOPFk8VihIO82JK-0

# ── Food Database (USDA FoodData Central) ──────────────────────
# Free, instant key — no approval needed
# Sign up at: https://api.data.gov/signup (takes 30 seconds)
# Limits: unlimited calls, 1,000 req/hr per key
USDA_API_KEY=WzBLRc0V8Vn7FNK8eqCBpfKKsceb2AdhP1aCPR7e
