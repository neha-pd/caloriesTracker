{
  "name": "fitkin",
  "version": "1.0.0",
  "private": true,
  "description": "Fitkin \u2014 Android fitness companion with a private Apps Script backend",
  "workspaces": [
    "mobile",
    "apps-script",
    "video"
  ],
  "scripts": {
    "mobile": "npm start --workspace mobile",
    "build:backend": "npm run build --workspace fitkin-sheets",
    "export:legacy": "tsx apps-script/export-data.ts",
    "test": "npm run build:backend && tsx --test apps-script/test/*.test.ts checks/*.test.ts",
    "typecheck": "npm run typecheck --workspace mobile && tsc -p apps-script/tsconfig.json",
    "test:train": "tsx --test checks/train.test.ts",
    "video:studio": "npm run studio --workspace video",
    "video:render": "npm run render --workspace video"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-worklets": "0.10.1"
  },
  "dependencies": {},
  "devDependencies": {
    "tsx": "^4.16.2",
    "typescript": "~5.9.2"
  }
}
