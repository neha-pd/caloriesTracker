{
  "expo": {
    "name": "FitLens",
    "slug": "fitlens",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fitlens.app",
      "infoPlist": {
        "NSCameraUsageDescription": "FitLens uses your camera to identify food and estimate portions.",
        "NSPhotoLibraryUsageDescription": "FitLens accesses your photo library to log meals.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121212"
      },
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.WRITE_NUTRITION",
        "android.permission.health.WRITE_HYDRATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.fitlens.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "FitLens uses your camera to identify food."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FitLens accesses your photos to log meals."
        }
      ],
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "FitLens reads your steps and active energy, including Apple Watch activity, to show your daily movement.",
          "NSHealthUpdateUsageDescription": "FitLens saves meals, nutrition, and water you confirm to Apple Health."
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          },
          "android": {
            "minSdkVersion": 28
          }
        }
      ],
      "expo-notifications",
      "expo-secure-store"
    ],
    "scheme": "fitlens",
    "extra": {
      "eas": {
        "projectId": "dea91dae-087c-48f6-b312-4adf62c191ca"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    }
  }
}
